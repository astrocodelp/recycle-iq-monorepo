{
  "name": "@recycleiq/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres (Neon) schema, migrations and seed data for RecycleIQ, via Drizzle ORM.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "drizzle-kit check",
    "import:osm": "tsx src/import-osm-bins.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@recycleiq/engine": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@recycleiq/tsconfig": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
