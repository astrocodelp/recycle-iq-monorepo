{
  "name": "@recycleiq/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "RecycleIQ design tokens: one source (tokens.json) for the web (Tailwind v4 theme) and React Native (tokens.ts).",
  "type": "module",
  "exports": {
    ".": "./src/tokens.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/generate.mjs --check"
  },
  "devDependencies": {
    "@recycleiq/tsconfig": "workspace:*",
    "typescript": "6.0.3"
  }
}
