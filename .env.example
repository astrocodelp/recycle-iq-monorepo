# Postgres connection string.
# Neon (preview/production): set by the Vercel <-> Neon integration, pooled URL with ?sslmode=require.
# Local: docker compose up -d, then use the URL below.
# If port 5432 is already in use on your computer, set DB_PORT=5433 and change 5432 to 5433 in DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgres://recycleiq:recycleiq@localhost:5432/recycleiq

# Optional: a direct (unpooled) Neon URL for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Public URL of the web app, used in bin QR codes. Defaults to the request host.
# NEXT_PUBLIC_SITE_URL=https://recycleiq.example.gr
