# Postgres connection string.
# Neon (preview/production): set by the Vercel <-> Neon integration, pooled URL with ?sslmode=require.
# Local: docker compose up -d, then use the URL below.
# If port 5432 is already in use on your computer, set DB_PORT=5433 and change 5432 to 5433 in DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgres://recycleiq:recycleiq@localhost:5432/recycleiq

# Optional: a direct (unpooled) Neon URL for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Public URL of the web app, used in bin QR codes. Defaults to the request host.
# NEXT_PUBLIC_SITE_URL=https://recycleiq.example.gr

# Optional: AthensGov citizen requests. Full-bin reports become "garbage" requests and bulky pickups
# "bulky_waste" requests in the city's system. Server-side only; leave empty to run without it.
# ATHENS_API_KEY=
# ATHENS_API_BASE=https://athensgov.cityofathens.gr/sandbox

# Assistant ("Ρώτα το RecycleIQ"): open-weight models through the Vercel AI Gateway.
# On Vercel the gateway authenticates with OIDC automatically (enable AI Gateway on the team).
# Locally, create a key in Vercel → AI Gateway → API Keys.
# AI_GATEWAY_API_KEY=
# ASSISTANT_MODEL=openai/gpt-oss-120b
# ASSISTANT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,alibaba/qwen-3-32b,meta/llama-4-scout,alibaba/qwen3-next-80b-a3b-instruct
# Optional: signs approval requests for assistant actions so a client cannot forge an approval.
# ASSISTANT_APPROVAL_SECRET=

# MCP connector (docs/MCP.md). Demo login code and token signing secret; set the secret in production.
# MCP_LOGIN_CODE=test123
# MCP_TOKEN_SECRET=
