{
  "name": "recycle-iq",
  "private": true,
  "description": "RecycleIQ: an explainable waste-disposal guide for the City of Athens (Apps4Athens 2026).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @recycleiq/tokens build",
    "db:generate": "pnpm --filter @recycleiq/db generate",
    "db:migrate": "pnpm --filter @recycleiq/db migrate",
    "db:seed": "pnpm --filter @recycleiq/db seed",
    "db:studio": "pnpm --filter @recycleiq/db studio"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
